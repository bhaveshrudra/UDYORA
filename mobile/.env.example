# UDYORA Mobile Application Environment Configuration Template
# NOTE: Never put private server secrets, API tokens, or private keys in this file.

# Public Backend Endpoint (For production multi-agent routing if hosted)
EXPO_PUBLIC_API_BASE_URL=https://api.udyora.gov.in

# Public Map Tile Configuration (Defaults to OpenStreetMap without key requirement)
EXPO_PUBLIC_MAP_PROVIDER=OPENSTREETMAP

# Default Application Environment
EXPO_PUBLIC_APP_ENV=production
